module

public import PetriNet.Semantics
public import Mathlib.Data.Finset.Basic

/-!
# Elementary Object Systems (EOS) under reference semantics

This file formalizes Elementary Object Systems (EOS) under reference semantics and the
construction of an equivalent P/T net, on top of `Cslib.PetriNet.PTNet`.

It follows the definitions of L. H. Costa Neto and E. H. Haeusler, *On the Observational
Equivalence of Object Petri Nets and Place/Transition Nets*, which originate in Chapter 4
of the first author's master's dissertation (*Redes de Petri como ferramenta
computacional* [Petri nets as a computational tool], PUC-Rio). The LaTeX labels of the
corresponding definitions are given in brackets.

## Main definitions

- `EOS k`: an EOS with `k` object nets [`defn:eos_structure`].
- `EOSMarking E`: a marking `(R, M)` of `E` under reference semantics [`eos_marking`].
- `EOSAction`, `EOSAction.Valid`, `EOSAction.Enabled`, `EOSAction.fire`: actions, their
  enabling and firing rules [`defn:action`].
- `eosToLTS E`: the labelled transition system generated by `E` [`defn:ts_from_eos`].
- `eosEquivNet E`: the equivalent P/T net [`defn:eos_eq_ptnet`].
- `eosToPTMarking E`: the equivalent marking in that net [`defn:eq_mark_eos_ptnet`].
-/

@[expose] public section

namespace Dissertation

open Cslib.PetriNet

universe u

/-- A multiset over `α`, given by its multiplicity function. -/
abbrev Bag (α : Type*) := α → ℕ

/-- A transition of type `T` or the empty transition `τ`, which does not change markings. -/
inductive TauOr (T : Type*) where
  | tau : TauOr T
  | some (t : T) : TauOr T
  deriving DecidableEq

/-- An action `(t̂, j, t)`: a system net transition (or `τ`), the index `j` of an object
net, and a transition of that object net (or `τ`) [`defn:action`]. -/
structure EOSAction (k : ℕ) (T_sys : Type*) (T_obj : Fin k → Type*) where
  tSys : TauOr T_sys
  netIdx : Fin k
  tObj : TauOr (T_obj netIdx)

/-- The structure of an EOS with `k` object nets [`defn:eos_structure`].

The system net has object places `P_ob`, black token places `P_bt`, transitions `T_sys`
and weights `preSys`/`postSys`; object net `i` has places `P_obj i`, transitions
`T_obj i` and weights `preObj i`/`postObj i`; `rho` is the interaction relation. -/
structure EOS (k : ℕ) where
  P_ob : Type u
  P_bt : Type u
  T_sys : Type u
  preSys : T_sys → P_ob ⊕ P_bt → ℕ
  postSys : T_sys → P_ob ⊕ P_bt → ℕ
  P_obj : Fin k → Type u
  T_obj : Fin k → Type u
  preObj : (i : Fin k) → T_obj i → P_obj i → ℕ
  postObj : (i : Fin k) → T_obj i → P_obj i → ℕ
  rho : Finset (T_sys × Sigma fun i => T_obj i)

/-- A marking of the system net under reference semantics: each object place holds a
multiset of object net indices, each black token place a number of tokens. -/
structure EOSSysMark (E : EOS k) where
  ob : E.P_ob → Bag (Fin k)
  bt : E.P_bt → ℕ

/-- A marking `(R, M)` of an EOS: the system net marking `R` and one marking per
object net [`eos_marking`]. -/
structure EOSMarking (E : EOS k) where
  sys : EOSSysMark E
  obj : (i : Fin k) → Marking (E.P_obj i)

/-- The places of the equivalent P/T net: one copy of each object place per object net,
the black token places, and the places of all object nets [`defn:eos_eq_ptnet`]. -/
def EOSPlaces (E : EOS k) : Type _ :=
  (E.P_ob × Fin k) ⊕ E.P_bt ⊕ Sigma E.P_obj

/-- The marking of the equivalent P/T net corresponding to an EOS marking
[`defn:eq_mark_eos_ptnet`]. -/
def eosToPTMarking (E : EOS k) (m : EOSMarking E) : Marking (EOSPlaces E) :=
  fun p =>
    match (p : EOSPlaces E) with
    | Sum.inl (p, i) => m.sys.ob p i
    | Sum.inr (Sum.inl p) => m.sys.bt p
    | Sum.inr (Sum.inr ⟨i, p⟩) => m.obj i p

/-- Extends a weight function `T → P → ℕ` to `TauOr T → P → ℕ`, with `τ` always weighing
`0` (the empty transition moves no tokens). -/
def TauOr.weight {T P : Type*} (w : T → P → ℕ) : TauOr T → P → ℕ
  | .tau => fun _ => 0
  | .some t => w t

/-- `t̂` is enabled in the system net considering only object tokens of type `j`
(part of [`defn:action`]). -/
def SysEnabled (E : EOS k) (R : EOSSysMark E) (j : Fin k) (tHat : E.T_sys) : Prop :=
  (∀ p, E.preSys tHat (Sum.inl p) ≤ R.ob p j) ∧
  (∀ p, E.preSys tHat (Sum.inr p) ≤ R.bt p)

/-- `t` is enabled in object net `j` for marking `m` (the usual P/T net enabling rule,
part of [`defn:action`]). -/
def ObjEnabled (E : EOS k) (j : Fin k) (m : Marking (E.P_obj j)) (t : E.T_obj j) : Prop :=
  ∀ p, E.preObj j t p ≤ m p

/-- The restriction in [`defn:action`]: when both `t̂` and `t` are non-empty, the pair
must belong to the interaction relation `ϱ`. When one of them is `τ`, the action is always
valid (transport or autonomous firing). -/
def EOSAction.Valid (E : EOS k) (a : EOSAction k E.T_sys E.T_obj) : Prop :=
  match a.tSys, a.tObj with
  | .some tHat, .some t => (tHat, ⟨a.netIdx, t⟩) ∈ E.rho
  | _, _ => True

/-- The valid actions of an EOS (`Σ` in [`defn:ts_from_eos`], the same set as `T_eq` in
[`defn:eos_eq_ptnet`]): the subtype of actions satisfying `EOSAction.Valid`. Invalid
actions (interactions not allowed by `ϱ`) do not exist as labels, neither for the EOS nor
for the equivalent net. -/
def EOSValidAction (E : EOS k) := {a : EOSAction k E.T_sys E.T_obj // a.Valid E}

/-- The equivalent P/T net, whose transitions are the valid actions
[`defn:eos_eq_ptnet`]. -/
def eosEquivNet (E : EOS k) : PTNet (EOSPlaces E) (EOSValidAction E) where
  pre := fun ⟨a, _⟩ p =>
    match (p : EOSPlaces E) with
    | Sum.inl (p, i) =>
        if i = a.netIdx then
          match a.tSys with
          | .tau => 0
          | .some tHat => E.preSys tHat (Sum.inl p)
        else 0
    | Sum.inr (Sum.inl p) =>
        match a.tSys with
        | .tau => 0
        | .some tHat => E.preSys tHat (Sum.inr p)
    | Sum.inr (Sum.inr ⟨i, p⟩) =>
        if h : i = a.netIdx then
          match a.tObj with
          | .tau => 0
          | .some t => E.preObj a.netIdx t (h ▸ p)
        else 0
  post := fun ⟨a, _⟩ p =>
    match (p : EOSPlaces E) with
    | Sum.inl (p, i) =>
        if i = a.netIdx then
          match a.tSys with
          | .tau => 0
          | .some tHat => E.postSys tHat (Sum.inl p)
        else 0
    | Sum.inr (Sum.inl p) =>
        match a.tSys with
        | .tau => 0
        | .some tHat => E.postSys tHat (Sum.inr p)
    | Sum.inr (Sum.inr ⟨i, p⟩) =>
        if h : i = a.netIdx then
          match a.tObj with
          | .tau => 0
          | .some t => E.postObj a.netIdx t (h ▸ p)
        else 0

/-- Action `a` is enabled in marking `(R, M)` [`defn:action`]: `t` is enabled in object
net `j` and `t̂` is enabled in the system net restricted to tokens of type `j`; `τ` is
always enabled [`tau`]. -/
def EOSAction.Enabled (E : EOS k) (M : EOSMarking E) (a : EOSAction k E.T_sys E.T_obj) :
    Prop :=
  (match a.tObj with
    | .tau => True
    | .some t => ObjEnabled E a.netIdx (M.obj a.netIdx) t) ∧
  (match a.tSys with
    | .tau => True
    | .some tHat => SysEnabled E M.sys a.netIdx tHat)

/-- The marking `(R', M')` obtained by firing action `a` from `(R, M)` [`defn:action`].
It is only meaningful when `a` is enabled in `M` (otherwise natural number subtraction
truncates at `0`, as in `PTNet.fire`). -/
def EOSAction.fire (E : EOS k) (M : EOSMarking E) (a : EOSAction k E.T_sys E.T_obj) :
    EOSMarking E where
  sys :=
    { ob := fun p i =>
        if i = a.netIdx then
          M.sys.ob p i - TauOr.weight E.preSys a.tSys (Sum.inl p)
            + TauOr.weight E.postSys a.tSys (Sum.inl p)
        else M.sys.ob p i
      bt := fun p =>
        M.sys.bt p - TauOr.weight E.preSys a.tSys (Sum.inr p)
          + TauOr.weight E.postSys a.tSys (Sum.inr p) }
  obj := Function.update M.obj a.netIdx
    (fun p =>
      M.obj a.netIdx p - TauOr.weight (E.preObj a.netIdx) a.tObj p
        + TauOr.weight (E.postObj a.netIdx) a.tObj p)

/-- The labelled transition system generated by an EOS under reference semantics
[`defn:ts_from_eos`]: there is a step `(R, M) →a (R', M')` iff `a` is a valid action
(guaranteed by the subtype `EOSValidAction`), enabled in `(R, M)` (`EOSAction.Enabled`),
and `(R', M')` is the result of firing it (`EOSAction.fire`). -/
noncomputable def eosToLTS (E : EOS k) :
    Cslib.LTS (EOSMarking E) (EOSValidAction E) where
  Tr := fun M ⟨a, _⟩ M' => a.Enabled E M ∧ a.fire E M = M'

end Dissertation
