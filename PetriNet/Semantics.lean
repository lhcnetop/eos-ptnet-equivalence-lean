module

public import Cslib.Foundations.Semantics.LTS.Basic
public import PetriNet.Basic

/-!
# LTS Semantics for P/T Nets

This file connects `PTNet` to the `LTS` abstraction from CSLib, defining the
labelled transition system generated by a P/T net and proving its key properties.

## Main definitions

- `PTNet.toLTS` is the `LTS` whose states are markings of type `Marking P`,
  whose labels are transitions of type `T`, and where `Tr M t M'` holds when
  `t` is enabled in `M` and firing `t` from `M` yields `M'`.

## Main statements

- `PTNet.toLTS_Tr_iff`: unfolds `toLTS.Tr` as enabledness plus firing equality.
- `PTNet.toLTS_deterministic`: the LTS of a P/T net is deterministic — a given
  marking and transition have at most one successor.
- `PTNet.reachable_iff_canReach`: `PTNet.Reachable` coincides with `LTS.CanReach`
  on `toLTS`, connecting the standalone reachability definition to the CSLib abstraction.

## References

* [W. Reisig, *Petri Nets: An Introduction*][Reisig1985]
-/

@[expose] public section

namespace Cslib.PetriNet

namespace PTNet

variable {P : Type u} {T : Type v}

/-- The LTS generated by a P/T net.

States are markings, labels are transitions, and a transition `Tr M t M'` holds
when `t` is enabled in `M` and the result of firing `t` from `M` is `M'`. -/
def toLTS (N : PTNet P T) : LTS (Marking P) T where
  Tr M t M' := N.Enabled M t ∧ N.fire M t = M'

/-! ## Lemmas -/

/-- Unfolds `toLTS.Tr` as enabledness plus firing equality. -/
@[simp]
theorem toLTS_Tr_iff {N : PTNet P T} {M M' : Marking P} {t : T} :
    N.toLTS.Tr M t M' ↔ N.Enabled M t ∧ N.fire M t = M' := Iff.rfl

/-- The LTS of a P/T net is deterministic: for a fixed marking and transition,
there is at most one successor marking (since `fire` is a function). -/
instance toLTS_deterministic (N : PTNet P T) : N.toLTS.Deterministic where
  deterministic _ _ _ _ h₁ h₂ := h₁.2.symm.trans h₂.2

/-! ## Reachability -/

private lemma mtr_imp_reachable {N : PTNet P T} {M₀ M : Marking P} {ts : List T}
    (h : N.toLTS.MTr M₀ ts M) : N.Reachable M₀ M := by
  induction h with
  | refl          => exact .refl
  | stepL htr _ ih =>
    obtain ⟨hen, hfire⟩ := htr
    exact .step hen (hfire ▸ ih)

/-- `PTNet.Reachable` coincides with `LTS.CanReach` on `toLTS`:
the standalone reachability relation is equivalent to the CSLib abstraction. -/
theorem reachable_iff_canReach {N : PTNet P T} {M₀ M : Marking P} :
    N.Reachable M₀ M ↔ N.toLTS.CanReach M₀ M := by
  constructor
  · intro h
    induction h with
    | refl        => exact ⟨[], .refl⟩
    | step hen _ ih =>
      obtain ⟨ts, hmtr⟩ := ih
      exact ⟨_ :: ts, .stepL ⟨hen, rfl⟩ hmtr⟩
  · intro ⟨ts, hmtr⟩
    exact mtr_imp_reachable hmtr

end PTNet

end Cslib.PetriNet
